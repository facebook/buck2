def _inputs(ctx):
    result = {}
    for node in ctx.aquery().all_actions("//:mixed"):
        if node.rule_type == "analysis":
            continue
        action = node.action()
        dependencies = ctx.aquery().deps([action], depth = 1)
        paths = sorted({output.short_path: None for dep in dependencies if dep.rule_type != "analysis" for output in dep.action().outputs()}.keys())
        for output in action.outputs():
            result[output.short_path] = paths
    ctx.output.print_json(result)

inputs = bxl_main(impl = _inputs, cli_args = {})
