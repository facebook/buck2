load("//rules:rules.bzl", "lib")

# `root` depends on a good target and a target in a package that fails to parse.
lib(
    name = "root",
    deps = [
        "//good:g",
        "//broken:b",
    ],
)

lib(name = "leaf")

lib(
    name = "good_only",
    deps = ["//good:g"],
)
