load("@fbsource//tools/build_defs:rust_binary.bzl", "rust_binary")
load("@fbsource//tools/build_defs:rust_library.bzl", "rust_library")
load("@fbsource//xplat/third-party/zstd:defs.bzl", "zstd_compress")

oncall("build_infra")

rust_binary(
    name = "buck2_miniperf",
    srcs = glob(
        ["src/**/*.rs"],
    ),
    allocator = "malloc",
    allow_cache_upload = True,
    # JEMalloc isn't super lean (and we don't actually allocate anything here),
    # so dont use it.
    default_strip_mode = "full",
    # Under `build_info=full` the linker would otherwise stamp revision/time/user
    # straight into the binary, making the link non-hermetic and so ineligible
    # for cache upload. Late stamping moves that into a separate action and
    # leaves the link itself reproducible.
    late_build_info_stamping = True,
    # Must be statically linked because the binary is embedded in the forkserver
    # and written to disk without its shared library dependencies.
    link_style = "static",
    # Keep this dep set small and slow-moving. Anything that invalidates this
    # target's link also re-compresses the binary and re-runs the `objcopy` that
    # embeds it into `buck2` (see `elf_sections` on `//buck2/app/buck2:buck2-bin`),
    # a local action over the whole executable.
    deps = [
        "fbsource//third-party/rust:anyhow",
    ] + select({
        # Ideally we'd use compatible_with, but TD does not understand that.
        "DEFAULT": [],
        "ovr_config//os:linux": [
            "fbsource//third-party/rust:bincode",
            "fbsource//third-party/rust:perf-event",
            "fbsource//third-party/rust:smallvec",
            "fbsource//third-party/rust:thiserror",
            "//buck2/app/buck2_miniperf_proto:buck2_miniperf_proto",
        ],
    }),
)

# The payload of the `buck2_miniperf` ELF section in `buck2`; the forkserver
# decompresses it back to disk before exec'ing it.
zstd_compress(
    name = "embedded_section",
    src = ":buck2_miniperf",
    visibility = ["PUBLIC"],
)

