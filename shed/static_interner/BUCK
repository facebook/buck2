load("@fbsource//tools/build_defs:rust_library.bzl", "rust_library")

oncall("build_infra")

rust_library(
    name = "static_interner",
    srcs = glob(["src/**/*.rs"]),
    autocargo = {
        "cargo_toml_config": {
            "dependencies_override": {
                "dependencies": {
                    # Each is gated behind a same-named feature. The published
                    # crate wants none of allocative's own features.
                    "allocative": {"features": [], "optional": True, "workspace": False},
                    "dupe": {"optional": True},
                    "strong_hash": {"optional": True},
                },
            },
            "features": {
                "allocative": ["dep:allocative"],
                "default": [],
                "dupe": ["dep:dupe"],
                "strong_hash": ["dep:strong_hash"],
            },
            "package": {
                "description": "Similar to `internment` crate, but with interface and performance tweaks",
                # Gives the explicit path dependency above its version, which
                # publishing requires.
                "publish": True,
                "version": "0.1.3",
            },
        },
    },
    crate_root = "src/lib.rs",
    # buck2 uses every integration impl (`Allocative`, `Dupe`, `StrongHash`) on
    # `Intern<T>`, so enable all features. OSS users on crates.io opt in via
    # cargo features as needed; default is no impls.
    features = [
        "allocative",
        "dupe",
        "strong_hash",
    ],
    deps = [
        "fbsource//third-party/rust:equivalent",
        "//buck2/allocative/allocative:allocative",
        "//buck2/gazebo/dupe:dupe",
        "//buck2/gazebo/strong_hash:strong_hash",
        "//buck2/shed/lock_free_hashtable:lock_free_hashtable",
    ],
)
