headers_dir(
    name = "headers",
    headers = ["app.h", "other.h"],
)

c_binary(
    name = "app",
    main = "app.c",
    headers = ["app.h", "other.h"],
    headers_dir_written = "$(@query_outputs :headers)",
    unused_command_line_param = read_config("test", "unused_command_line_param", "default"),
)

c_binary(
    name = "app_with_dummy_config",
    main = "app.c",
    headers = ["app.h", "other.h"],
    headers_dir_written = "$(@query_outputs :headers)",
    unused_command_line_param = read_config("test", "unused_command_line_param", "default"),
    _ignored = read_config("test", "dummy_config"),
)

simple_dep_file(
    name = "simple_dep_file",
    used_input1_contents = read_config("test", "used_input1_contents", "default"),
    used_input2_contents = read_config("test", "used_input2_contents", "default"),
    unused_input1_contents = read_config("test", "unused_input1_contents", "default"),
    unused_input2_contents = read_config("test", "unused_input2_contents", "default"),
)

shared_dir_dep_file(
    name = "shared_dir_dep_file",
    used_input_contents = read_config("test", "used_input_contents", "default"),
    unused_input_contents = read_config("test", "unused_input_contents", "default"),
)

canonical_json_dep_file(
    name = "canonical_json",
    format = read_config("test", "canonical_format", "json"),
    executable = read_config("test", "canonical_executable", "false") == "true",
    used = read_config("test", "canonical_used", "used"),
    unused = read_config("test", "canonical_unused", "unused"),
    unused_src = "other.h" if read_config("test", "canonical_unused_src", "false") == "true" else None,
    untagged = read_config("test", "canonical_untagged", "extra"),
    option = "" if read_config("test", "canonical_empty_option", "false") == "true" else read_config("test", "canonical_option", "option"),
    placement = read_config("test", "canonical_placement", "direct"),
    use_content_based_paths = read_config("test", "use_content_based_paths", "true") == "true",
    reverse = read_config("test", "canonical_reverse", "false") == "true",
    repeat = read_config("test", "canonical_repeat", "false") == "true",
    pretty = read_config("test", "canonical_pretty", "false") == "true",
    absolute = read_config("test", "canonical_absolute", "false") == "true",
)

# A run action whose input differs per configuration.
cross_config_run(
    name = "select_divergent",
    marker_content = select({
        "root//platforms:config_a": "a",
        "root//platforms:config_b": "b",
    }),
    _ignored = read_config("test", "dummy_config"),
)

dep_file_with_preceding_actions(
    name = "dep_file_with_preceding_actions",
)

dir_output_dep_file(
    name = "dir_output_dep_file",
    used_input_contents = read_config("test", "used_input_contents", "default"),
    unused_input_contents = read_config("test", "unused_input_contents", "default"),
)

path_args(
    name = "persisted_dep_file_output_args",
    src = ":simple_dep_file",
)

consume_path_args(
    name = "consume_persisted_dep_file_output",
    args = ":persisted_dep_file_output_args",
    trigger = "other.h",
)

canonical_platforms(name = "canonical_platforms")
