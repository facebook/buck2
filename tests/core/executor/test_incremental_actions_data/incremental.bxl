def _incremental_impl(ctx):
    actions = ctx.bxl_actions().actions
    out = actions.declare_output("out", has_content_based_path = True)
    script = actions.write(
        "script.py",
        [
            "import os, sys",
            "out = sys.argv[1]",
            "content = open(out).read() + ' bar' if os.path.exists(out) else 'foo'",
            "open(out, 'w').write(content)",
        ],
        has_content_based_path = False,
    )
    name = actions.write("name", ctx.cli_args.name, has_content_based_path = False)
    actions.run(
        cmd_args(["fbpython", script, out.as_output()], hidden = [name]),
        category = "incremental",
        no_outputs_cleanup = True,
        local_only = True,
        metadata_env_var = "METADATA_PATH",
        metadata_path = "metadata.json",
    )
    ctx.output.print(ctx.output.ensure(out))

incremental = bxl_main(
    impl = _incremental_impl,
    cli_args = {"name": cli_args.string()},
)
