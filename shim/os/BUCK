config_setting(
    name = "linux",
    constraint_values = [
        "prelude//os/constraints:linux",
    ],
    visibility = ["PUBLIC"],
)

config_setting(
    name = "linux-fedora",
    constraint_values = [
        "prelude//os/constraints:os[linux]",
        "//os/linux/distro/constraints:distro[fedora]",
    ],
    visibility = ["PUBLIC"],
)

