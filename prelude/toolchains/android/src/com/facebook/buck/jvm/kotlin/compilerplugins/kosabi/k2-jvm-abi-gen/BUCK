# @oss-disable[end= ]: load("@fbsource//tools/build_defs:kotlin_version.bzl", "toolchain_kotlin_version")
load("@prelude//toolchains/android/tools:build_rules.bzl", "buck_java_binary", "buck_kotlin_library")
load("@prelude//utils:source_listing.bzl", "source_listing")

oncall("android_devxx")

source_listing()

# compilercompat shims match the compiler actually run: key off the version the kotlincd
# toolchain selects the compiler jar from. 2.2 and 2.3 share minor-version buckets
# (compilercompat/2.2.0, compilercompat/2.3.0); newer compilers use full-version buckets.
# @oss-disable[end= ]: _KOTLIN_FULL_VERSION = toolchain_kotlin_version()
_KOTLIN_FULL_VERSION = read_root_config("kotlin", "kotlin_version", "2.3.21") # @oss-enable

_KOTLIN_VERSION_PARTS = _KOTLIN_FULL_VERSION.split(".")

KOTLIN_VERSION = (
    _KOTLIN_FULL_VERSION
    if (int(_KOTLIN_VERSION_PARTS[0]), int(_KOTLIN_VERSION_PARTS[1])) >= (2, 4)
    else _KOTLIN_VERSION_PARTS[0] + "." + _KOTLIN_VERSION_PARTS[1] + ".0"
)

buck_kotlin_library(
    name = "k2-jvm-abi-gen-lib",
    srcs = glob(
        ["**/*.kt"],
        exclude = ["src/main/kotlin/compilercompat/*/*.kt"],
    )
    + (
        glob(["src/main/kotlin/compilercompat/" + KOTLIN_VERSION + "/*.kt"])
        or fail("No k2-jvm-abi-gen compilercompat bucket for Kotlin " + _KOTLIN_FULL_VERSION)
    ),
    labels = ["codegen_rule"],
    provided_deps = [
        "prelude//toolchains/android/third-party:kotlin-compiler-embeddable",
    ],
    resources = glob(["resources/**"]),
    resources_root = "resources",
    visibility = [
        "PUBLIC",
    ],
    deps = [
        "fbsource//fbandroid/java/com/facebook/kotlin/compilercompat:compilercompat",
        "prelude//toolchains/android/src/com/facebook/buck/jvm/kotlin/compilerplugins/common:common",
        "prelude//toolchains/android/src/com/facebook/buck/jvm/kotlin/compilerplugins/kosabi/common/stub:stub",
        "prelude//toolchains/android/third-party:kotlin-metadata-jvm",
        "prelude//toolchains/android/third-party:kotlin-stdlib",
        "prelude//toolchains/android/third-party:kotlinx-coroutines-core-jvm",
    ],
)

buck_java_binary(
    name = "k2-jvm-abi-gen",
    visibility = ["PUBLIC"],
    deps = [":k2-jvm-abi-gen-lib"],
)
