load("@prelude//toolchains/android/tools:build_rules.bzl", "buck_java_binary", "buck_kotlin_library")
load("@prelude//utils:source_listing.bzl", "source_listing")

oncall("android_devxx")

source_listing()

buck_kotlin_library(
    name = "kosabi-common",
    srcs = glob(
        ["**/*.kt"],
        exclude = [
            "plugin/**",
            # The standalone CLI lives in its own library (`:stubsgen-cli-lib`) so that
            # kotlin-compiler-embeddable stays a runtime dep of the binary rather than a
            # provided_dep of this widely-consumed common library.
            "cli/**",
        ],
    ),
    labels = ["codegen_rule"],
    provided_deps = [
        "prelude//toolchains/android/third-party:kotlin-compiler",
        "prelude//toolchains/android/third-party:kotlin-reflect",
    ],
    visibility = [
        "PUBLIC",
    ],
    deps = [
        "prelude//toolchains/android/third-party:kotlin-stdlib",
    ],
    exported_deps = [
        "prelude//toolchains/android/src/com/facebook/buck/jvm/kotlin/compilerplugins/kosabi/common:common",
        "prelude//toolchains/android/src/com/facebook/buck/jvm/kotlin/compilerplugins/kosabi/common/stub:stub",
    ],
)

buck_kotlin_library(
    name = "stubsgen-k2-plugin",
    srcs = glob(
        [
            "plugin/stubsgen_k2/*.kt",
        ],
    ),
    labels = ["codegen_rule"],
    provided_deps = [
        "prelude//toolchains/android/third-party:kotlin-compiler-embeddable",
    ],
    resources = glob(["plugin/stubsgen_k2/resources/**"]),
    resources_root = "plugin/stubsgen_k2/resources",
    tests = [
        "fbsource//fbandroid/javatests/com/facebook/kotlin/compilerplugins/kosabi/integrationtest:integration-test",
        "fbsource//fbandroid/javatests/com/facebook/kotlin/compilerplugins/kosabi/stubsgen:stubsgen",
    ],
    visibility = [
        "PUBLIC",
    ],
    deps = [
        "fbsource//fbandroid/java/com/facebook/kotlin/compilercompat:compilercompat",
        "fbsource//fbandroid/java/com/facebook/kotlin/compilercompat:compilercompat_with_ka",
    ],
    exported_deps = [
        ":kosabi-common",
    ],
)

buck_java_binary(
    name = "stubsgen_k2",
    visibility = ["PUBLIC"],
    deps = [":stubsgen-k2-plugin"],
)

# Standalone Kosabi stub generator that runs OUTSIDE kotlinc using a minimal, parse-only
# PSI environment (see cli/StubsGenParseOnlyEnvironment.kt). It reuses StubsGenApiImpl
# verbatim; the only extra runtime dependency is kotlin-compiler-embeddable, which provides
# both the Kotlin PSI and the shaded IntelliJ `com.intellij.core.*` environment.
buck_kotlin_library(
    name = "stubsgen-cli-lib",
    srcs = glob(["cli/**/*.kt"]),
    labels = ["codegen_rule"],
    visibility = ["PUBLIC"],
    deps = [
        ":kosabi-common",
        "prelude//toolchains/android/src/com/facebook/buck/jvm/kotlin/compilerplugins/common:common",
        "prelude//toolchains/android/third-party:kotlin-compiler-embeddable",
        # Required at runtime: the shaded IntelliJ MockApplication in kotlin-compiler-embeddable
        # spins up a coroutine scope during CoreApplicationEnvironment construction.
        "prelude//toolchains/android/third-party:kotlinx-coroutines-core-jvm",
    ],
)

buck_java_binary(
    name = "stubsgen-cli",
    main_class = "com.facebook.kotlin.compilerplugins.kosabi.stubsgen.cli.MainKt",
    visibility = ["PUBLIC"],
    deps = [":stubsgen-cli-lib"],
)
