load("@root//:rules.bzl", "command")

command(
    name = "local_only",
    command = "local_only.py",
    default_target_platform = "//platforms:target",
    exec_compatible_with = ["//platforms:default"],
)

command(
    name = "remote_only_prefer_local",
    command = "remote_only.py",
    default_target_platform = "//platforms:target",
    exec_compatible_with = ["//platforms:default"],
    prefer_local = True,
)

command(
    name = "local_only_no_fallback",
    command = "local_only.py",
    default_target_platform = "//platforms:target",
    exec_compatible_with = ["//platforms:no_fallback"],
)

command(
    name = "remote_only_no_fallback",
    command = "remote_only.py",
    default_target_platform = "//platforms:target",
    exec_compatible_with = ["//platforms:no_fallback"],
    prefer_local = True,
)

command(
    name = "remote_only_full_hybrid",
    command = "remote_only.py",
    default_target_platform = "//platforms:target",
    exec_compatible_with = ["//platforms:full_hybrid"],
)

command(
    name = "local_only_full_hybrid",
    command = "local_only.py",
    default_target_platform = "//platforms:target",
    exec_compatible_with = ["//platforms:full_hybrid_with_failure_fallbacks"],
)

# Remote execution fails this command and the fallback runs it locally; its result is not the
# one the platform configured it to produce, so it is not published.
command(
    name = "local_only_with_uploads",
    command = "local_only.py",
    default_target_platform = "//platforms:target",
    exec_compatible_with = ["//platforms:fallback_with_uploads"],
    allow_cache_upload = True,
)

# The same fallback for an action that may not publish at all, which is the reason reported.
command(
    name = "local_only_with_uploads_not_allowed",
    command = "local_only.py",
    default_target_platform = "//platforms:target",
    exec_compatible_with = ["//platforms:fallback_with_uploads"],
)

# The same command run locally by its own preference, which is published.
command(
    name = "prefer_local_with_uploads",
    command = "local_only.py",
    default_target_platform = "//platforms:target",
    exec_compatible_with = ["//platforms:fallback_with_uploads"],
    prefer_local = True,
    allow_cache_upload = True,
)

command(
    name = "fails_both",
    command = "fails_both.py",
    default_target_platform = "//platforms:target",
    exec_compatible_with = ["//platforms:default"],
)

command(
    name = "fails_both_prefer_local",
    command = "fails_both.py",
    default_target_platform = "//platforms:target",
    exec_compatible_with = ["//platforms:default"],
    prefer_local = True,
)
