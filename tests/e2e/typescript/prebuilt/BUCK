    name = "incompatible-consumer-typecheck",
    deps = [":incompatible-consumer"],
)

_typescript_binary(
    name = "incompatible-consumer-binary",
    srcs = ["src/incompatible_binary/index.ts"],
    entry_point = "src/incompatible_binary/index.ts",
    deps = [":incompatible-consumer"],
)

buck_genrule(
    name = "nested-declarations",
    out = "nested-declarations",
    cmd = "mkdir -p $OUT && echo 'export interface NestedValue { readonly nested: true; }' > $OUT/index.d.ts",
)

_typescript_prebuilt_package(
    name = "nested-scoped",
    package_name = "@nested/scoped",
    declaration_entry_point = "index.d.ts",
    declarations = ":nested-declarations",
    package_path = "node_modules/@prebuilt/parent/node_modules/@nested/scoped",
)

buck_genrule(
    name = "parent-declarations",
    out = "parent-declarations",
    cmd = "mkdir -p $OUT && echo \"import type {NestedValue} from '@nested/scoped'; export interface ParentValue { readonly child: NestedValue; }\" > $OUT/index.d.ts",
)

_typescript_prebuilt_package(
    name = "nested-parent",
    package_name = "@prebuilt/parent",
    declaration_entry_point = "index.d.ts",
    declarations = ":parent-declarations",
