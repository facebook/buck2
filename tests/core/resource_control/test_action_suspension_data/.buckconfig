[buildfile]
    name = TARGETS.fixture

[repositories]
    root = .
    prelude = .

[buck2_resource_control]
    status = required
    enable_suspension = true
    # Soft limit (throttle, not OOM-kill) combined with swap disabled so that reclaim stalls
    # instead of paging out. This is what produces sustained memory pressure once two actions
    # (~150 MB each) contend for the ~191 MiB budget, driving exactly one suspension.
    memory_high_actions = 200000000
    memory_swap_max_actions = 0

[build]
    threads = 5
