load("@fbcode_macros//build_defs:native_rules.bzl", "buck_genrule")
load(
    "@fbcode_macros//build_defs/lib/typescript:rules.bzl",
    _typescript_binary = "typescript_binary",
    _typescript_library = "typescript_library",
    _typescript_prebuilt_package = "typescript_prebuilt_package",
    _typescript_typecheck = "typescript_typecheck",
)
load(
    "//buck2/tests/e2e/typescript/first_class:identity_fixture.bzl",
    "package_info_consumer",
)

oncall("build_infra")

buck_genrule(
    name = "cjs-declarations",
    out = "cjs-declarations",
    cmd = "mkdir -p $OUT/lib && echo 'export interface Thing { readonly value: string; } export declare function value(input: string): string;' > $OUT/lib/index.d.ts && echo 'export declare function withSubpath(input: string): string;' > $OUT/lib/subpath.d.ts && echo '{\"name\":\"input-declarations\"}' > $OUT/package.json && chmod 0444 $OUT/package.json",
)

buck_genrule(
    name = "cjs-runtime",
    out = "cjs-runtime",
    cmd = 'mkdir -p $OUT/lib && echo "exports.value = input => \'prebuilt:\' + input;" > $OUT/lib/index.js && echo "exports.withSubpath = input => input + \':subpath\';" > $OUT/lib/subpath.js && echo \'{"name":"input-runtime"}\' > $OUT/package.json && chmod 0444 $OUT/package.json',
)

_typescript_prebuilt_package(
    name = "compatible-cjs",
    package_name = "@prebuilt/cjs",
    declaration_entry_point = "lib/index.d.ts",
    declarations = ":cjs-declarations",
    module_format = "commonjs",
    platform = "node",
    runtime = ":cjs-runtime",
    runtime_entry_point = "lib/index.js",
)

package_info_consumer(
    name = "runtime-package-info-consumer",
    dep = ":compatible-cjs",
)

_typescript_binary(
    name = "compatible-binary",
    srcs = ["src/compatible_binary/index.ts"],
    entry_point = "src/compatible_binary/index.ts",
    deps = [":compatible-cjs"],
)

_typescript_prebuilt_package(
    name = "declaration-only",
    package_name = "@prebuilt/types",
    declaration_entry_point = "lib/index.d.ts",
    declarations = ":cjs-declarations",
)

package_info_consumer(
    name = "declaration-only-package-info-consumer",
    dep = ":declaration-only",
)

_typescript_library(
    name = "declaration-consumer",
    package_name = "@prebuilt/declaration-consumer",
    srcs = ["src/declaration_consumer/index.ts"],
    entry_point = "src/declaration_consumer/index.ts",
    deps = [":declaration-only"],
)

_typescript_typecheck(
    name = "declaration-consumer-typecheck",
    deps = [":declaration-consumer"],
)

_typescript_binary(
    name = "declaration-only-binary",
    srcs = ["src/declaration_binary/index.ts"],
    entry_point = "src/declaration_binary/index.ts",
    deps = [":declaration-only"],
)

_typescript_prebuilt_package(
    name = "incompatible-runtime",
    package_name = "@prebuilt/incompatible",
    declaration_entry_point = "lib/index.d.ts",
    declarations = ":cjs-declarations",
    module_format = "esm",
    platform = "browser",
    runtime = ":cjs-runtime",
    runtime_entry_point = "lib/index.js",
)

_typescript_library(
    name = "incompatible-consumer",
    package_name = "@prebuilt/incompatible-consumer",
    srcs = ["src/incompatible_consumer/index.ts"],
    entry_point = "src/incompatible_consumer/index.ts",
    deps = [":incompatible-runtime"],
)

