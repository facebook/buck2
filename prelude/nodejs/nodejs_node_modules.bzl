load("@prelude//:prelude_rule.bzl", "prelude_rule")
load("@prelude//decls:common.bzl", "buck")
load(":nodejs_providers.bzl", "NodejsTreeInfo", "is_relative_slash_path")

def nodejs_node_modules_impl(ctx: AnalysisContext) -> list[Provider]:
    outs = ctx.attrs.src[DefaultInfo].default_outputs
    if len(outs) != 1:
        fail("nodejs_node_modules {}: `src` target `{}` must have exactly one default output".format(ctx.label, ctx.attrs.src.label))
    path = ctx.attrs.path
    if not is_relative_slash_path(path):
        fail("nodejs_node_modules {}: invalid `path` '{}': must be a relative path using '/' separators with no '.' or '..' segments".format(ctx.label, path))
    for package_name in ctx.attrs.exclude:
        segments = package_name.split("/")
        if (
            not is_relative_slash_path(package_name)
            or len(segments) > (2 if package_name.startswith("@") else 1)
            or package_name == "@"
            or package_name.startswith(".")
        ):
            fail(
                "nodejs_node_modules {}: invalid `exclude` entry '{}': must be a package name, `name` or `@scope/name`, or a scope, `@scope`".format(
                    ctx.label, package_name
                )
            )
    tree = outs[0].project(path)
    manifest = ctx.actions.declare_output("manifest.json")
    ctx.actions.run(
        cmd_args(ctx.attrs._package_tree_tool[RunInfo], "manifest", "--tree", tree, "--out", manifest.as_output()),
        category = "nodejs_tree_manifest",
    )
    return [
        DefaultInfo(default_output = tree, sub_targets = {"manifest": [DefaultInfo(default_output = manifest)]}),
        NodejsTreeInfo(node_modules = tree, manifest = manifest, owner = ctx.label, exclude = ctx.attrs.exclude),
    ]

nodejs_node_modules = prelude_rule(
    name = "nodejs_node_modules",
    impl = nodejs_node_modules_impl,
    docs = """A prebuilt `node_modules` directory tree, for third-party
    packages with no `nodejs_library` target (e.g. a yarn install output).
    `src` is a target whose default output is a directory; `path` (default
    `"node_modules"`) is the tree's relative, `/`-separated location inside
    that output, with no `.` or `..` segments. The default
    output is the tree itself, and consumers take it via `node_modules`.
    The `[manifest]` sub-target is a JSON file listing each top-level and
    scoped package of the tree with its `name` and, from its
    `package.json`, `version`, `os`, `cpu`, `libc`, `bin` and the names of
    its dependencies, optional dependencies and peer dependencies; a
    package reached through a symlink records the link, and dot entries
    such as `.bin` and `.yarn-integrity` are listed under `ignored`.
    A `nodejs_library` compile composes the tree package by package from
    it, so a package name this tree and another source both provide fails
    that compile and names both, as does a package or scope that is not
    excluded and cannot be read or is reached through a symlink that is
    dangling or resolves to the tree itself or outside it. `exclude` lists package names (`name` or
    `@scope/name`) and scopes (`@scope`, every package in it) that such a
    compile never composes out of this tree; each must be a package or
    scope the tree provides. A package reached through a symlink is
    composed alone, from the directory it resolves to, and dot entries such
    as `.pnpm` are never composed, so in an isolated layout such as pnpm's
    a package's dependencies are visible only if they are also at the top
    level of the tree. `nodejs_binary` and `nodejs_test` compose the
    tree the same way, honouring `exclude`. The tree is used as installed:
    a subset, such as the production dependencies only, comes from the
    installer.""",
    examples = None,
    further = None,
    attrs = (
        # @unsorted-dict-items
        {
            "src": attrs.dep(),
            "path": attrs.string(default = "node_modules"),
            "exclude": attrs.list(attrs.string(), default = []),
            "_package_tree_tool": attrs.default_only(attrs.exec_dep(providers = [RunInfo], default = "prelude//nodejs/tools:package_tree")),
        }
        | buck.labels_arg()
        | buck.contacts_arg()
    ),
)
