def _main(ctx: bxl.Context):
    actions = ctx.bxl_actions().actions
    input = actions.write(
        "input.txt",
        ctx.cli_args.value,
        has_content_based_path = False,
    )
    output = actions.declare_output("output.txt", has_content_based_path = False)

    def dynamic_callback(ctx, artifacts, outputs):
        content = artifacts[input].read_string()
        ctx.bxl_actions().actions.write(outputs[output], content)

    actions.dynamic_output(
        dynamic = [input],
        inputs = [],
        outputs = [output.as_output()],
        f = dynamic_callback,
    )
    ctx.output.ensure(output)

main = bxl_main(
    cli_args = {
        "value": cli_args.string(),
    },
    impl = _main,
)
