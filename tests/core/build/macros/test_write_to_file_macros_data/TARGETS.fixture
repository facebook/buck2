load(":defs.bzl", "input", "macro_writer", "test_rule", "write_file")

write_file(name = "write_file")

test_rule(name = "test_rule", arg = "$(@query_outputs :write_file)")

input(name = "payload")

input(name = "unrelated", fail = True)

macro_writer(
    name = "macro_only",
    inline = "$(location :unrelated)",
    macro = "$(@location :payload)",
)

macro_writer(
    name = "macro_only_tagged",
    inline = "$(location :unrelated)",
    macro = "$(@location :payload)",
    tagged = True,
)

macro_writer(
    name = "hidden_macro",
    hidden = True,
    macro = "$(@location :payload)",
)

macro_writer(
    name = "hidden_macro_tagged",
    hidden = True,
    macro = "$(@location :payload)",
    tagged = True,
)
