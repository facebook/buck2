def _impl(ctx: bxl.Context):
    for name in ["arg_exe", "arg_location"]:
        node = ctx.configured_targets("root//groups:" + name)
        ctx.output.print(node.attrs_lazy().get("cmd").strip_cfg())

strip_cfg = bxl_main(impl = _impl, cli_args = {})
