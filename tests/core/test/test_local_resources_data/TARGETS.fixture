load(":rules.bzl", "broker", "daemon_broker", "daemon_test", "test", "two_types_one_broker_test")

broker(
    name = "my_broker",
)

test(
    name = "my_test",
    broker = ":my_broker",
)

daemon_broker(
    name = "my_daemon_broker",
)

daemon_test(
    name = "my_daemon_test",
    broker = ":my_daemon_broker",
)

two_types_one_broker_test(
    name = "two_types_one_broker",
    broker = ":my_broker",
)
