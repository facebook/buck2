def _impl(ctx: bxl.Context):
    target = ctx.configured_targets("fbcode//buck2/tests/e2e/test_prelude:clone_rule_cfg_fixture")
    expected = "fbcode//buck2/tests/e2e/test_prelude:clone_rule_cfg_value"
    for configured_target in ctx.cquery().deps(target, 1):
        constraint_values = [str(value.label) for value in configured_target.configuration_info().constraints.values()]
        if expected in constraint_values:
            return
    fail("Expected clone_rule caller cfg to add its constraint")

test = bxl_main(
    impl = _impl,
    cli_args = {},
)
