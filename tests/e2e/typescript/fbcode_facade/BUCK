buck_genrule(
    name = "prebuilt-declarations",
    out = "prebuilt-declarations",
    cmd = "mkdir -p $OUT && echo 'export declare function value(input: string): string;' > $OUT/index.d.ts",
)

buck_genrule(
    name = "prebuilt-runtime",
    out = "prebuilt-runtime",
    cmd = "mkdir -p $OUT && echo \"exports.value = input => 'prebuilt:' + input;\" > $OUT/index.js",
)

