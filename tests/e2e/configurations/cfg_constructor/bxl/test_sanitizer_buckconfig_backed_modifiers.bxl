load("@fbcode_macros//build_defs:sanitizers.bzl", "sanitizers")
load("@prelude//:asserts.bzl", "asserts")
load("@prelude//cfg/modifier:cfg_constructor.bzl", "cfg_constructor_post_constraint_analysis", "cfg_constructor_pre_constraint_analysis")
load("@prelude//cfg/modifier:types.bzl", "BuckconfigBackedModifierInfo")
load(":util.bxl", "ALIASES", "TestRefs", "get_test_refs")

_BUCKCONFIG_BACKED_MODIFIERS = "fbcode//buck2/tests/e2e/configurations/cfg_constructor/bxl:test_sanitizer_modifiers"

def _run_cfg_constructor(ctx: bxl.Context, test_refs: TestRefs, target_modifiers: list[str] | None) -> PlatformInfo:
    modifiers = ctx.configured_targets(_BUCKCONFIG_BACKED_MODIFIERS)
    modifiers_providers = ctx.analysis(modifiers).providers()
    asserts.true(BuckconfigBackedModifierInfo in modifiers_providers)

    refs, params = cfg_constructor_pre_constraint_analysis(
        package_modifiers = None,
        legacy_platform = None,
        target_modifiers = target_modifiers,
        cli_modifiers = [],
        rule_name = "_dummy",
        aliases = ALIASES,
        extra_data = struct(buckconfig_backed_modifiers = _BUCKCONFIG_BACKED_MODIFIERS),
        configuring_exec_dep = False,
    )
    refs = {ref: modifiers_providers if ref == _BUCKCONFIG_BACKED_MODIFIERS else test_refs.get(ref) for ref in refs}
    return cfg_constructor_post_constraint_analysis(refs = refs, params = params)

def _impl(ctx: bxl.Context):
    test_refs = get_test_refs(ctx)

    sanitizer = read_config("test", "sanitizer")
    platform = _run_cfg_constructor(ctx, test_refs, target_modifiers = None)
    expected = test_refs.make_cfg([sanitizers.get_sanitizer_constraint(sanitizer)]) if sanitizer != None else test_refs.make_cfg([])
    asserts.equals(expected, platform.configuration)

    nosan = "ovr_config//build_mode:sanitizer_type[no-san]"
    platform = _run_cfg_constructor(ctx, test_refs, target_modifiers = [nosan])
    asserts.equals(test_refs.make_cfg([nosan]), platform.configuration)

test = bxl_main(
    impl = _impl,
    cli_args = {},
)
