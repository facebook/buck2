def _bxl_run_impl(ctx):
    actions = ctx.bxl_actions().actions
    marker = actions.write("marker", ctx.cli_args.marker_content, has_content_based_path = False)
    out = actions.declare_output("out", has_content_based_path = False)
    actions.run(cmd_args(["cp", marker, out.as_output()]), category = "bxl_run")
    ctx.output.print(ctx.output.ensure(out))

bxl_run = bxl_main(
    impl = _bxl_run_impl,
    cli_args = {
        "marker_content": cli_args.string(default = "bxl"),
    },
)
